# ─────────────────────────────────────────────
#  Cat Care — Environment Variables
#  คัดลอกไฟล์นี้เป็น .env แล้วกรอกค่าจริง
# ─────────────────────────────────────────────

# PostgreSQL Connection
DATABASE_URL=postgresql://catcare_user:yourpassword@localhost:5432/catcare_db

# LINE Notifications
LINE_NOTIFY_TOKEN=your_line_notify_token_here
LINE_MESSAGING_CHANNEL_TOKEN=your_channel_access_token_here
LINE_MESSAGING_USER_ID=Uxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# APScheduler — เวลาที่รัน Notification Job (24h format)
NOTIFIER_CRON_HOUR=7
NOTIFIER_CRON_MINUTE=0
